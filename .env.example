# Copy to .env.local and fill in from your Supabase project settings
# (Project Settings -> API). Never commit .env.local.

# Safe to expose to the browser: the anon key only grants what your RLS
# policies allow, which is why the policies are the real security boundary.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Bypasses RLS entirely — never prefix with NEXT_PUBLIC_, never
# import into a client component. Only needed by the RLS test suite today.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used to build invite links. Set to your deployed origin in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
